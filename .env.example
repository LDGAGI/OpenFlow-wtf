# Required only when reference media must be exposed to an external provider.
REFERENCE_UPLOAD_SECRET=

# Optional. Defaults to ./data/reference-uploads.
REFERENCE_UPLOAD_DIR=./data/reference-uploads

# Optional. Set this to the public HTTPS origin of this deployment when the
# request origin is not reachable by the image or video provider.
REFERENCE_MEDIA_PUBLIC_BASE_URL=
